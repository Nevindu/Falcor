import ReSTIRPTLF;
import LoadShadingData;
import Scene.RaytracingInline;
import LightField;

/** Random replay (primary-sample-space) shift mapping.

    Maps a source sample X into the destination pixel by replaying the source
    path's exact random-number stream from the destination primary surface y1.
    Unlike reconnection shift, no geometric suffix is reused: the whole tail is
    regenerated by the path tracer at the destination, so the map is the identity
    on the random coordinates and the Jacobian is 1.

    Implementation:
      The full estimator (NEE/MIS/env/glossy/RR) already lives in
      ReSTIRPTLF.handleHit()/handleMiss(). Random replay reuses them directly by
      building a PathState that is seeded with the source sample's RNG stream but
      positioned at the destination primary hit, then driving handleHit/handleMiss
      from an inline trace loop. This matches the canonical path-tracer estimator
      exactly and minimizes divergence bias.

    Convention (see ShiftMappingResult): shiftedContribution is the destination
    estimator value for Y, shiftedTarget = pHat(Y) = luminance(shiftedContribution),
    and jacobian = 1 (pure PSS replay).

    Validity: accept iff the replayed destination path's initial-RIS selection lands
    on the same path technique as the source (selectedKind and selectedVertex) with
    a positive target; otherwise reject.

    Known limitations:
      - Cost: each call retraces a full path, and the spatial pass re-invokes the
        shift per proposal domain for generalized/pairwise MIS. This is heavy, but
        comparable to the reconnection replay branch and acceptable for now.
      - Already-shifted samples have no canonical RNG stream to replay and are
        rejected (matches reconnection's replay handling).
      - Directly-visible environment samples (no surface tail) cannot be realized at
        a surface destination under replay and are rejected.
*/
/** Inline visibility query for replay run inside a compute/raytracing-inline
    context (mirrors the TracePass scheduler's visibility query).
*/
struct RandomReplayVisibilityQuery : IVisibilityQuery
{
    bool traceVisibilityRay(const Ray ray)
    {
        SceneRayQuery<kUseAlphaTest> sceneRayQuery;
        return sceneRayQuery.traceVisibilityRay(ray);
    }
};

extension ReSTIRPTLF
{
    /** Advance to the next vertex and trace the scatter ray
        prepared by handleHit().
    */
    void randomReplayNextHit(inout PathState path)
    {
        path.incrementVertexIndex();
        SceneRayQuery<kUseAlphaTest> sceneRayQuery;
        float hitT;
        const HitInfo hit = sceneRayQuery.traceRay(path.getScatterRay(), hitT);
        path.clearHit();
        if (hit.isValid())
        {
            path.setHit(hit);
            path.sceneLength += float16_t(hitT);
        }
    }

    ShiftMappingResult applyRandomReplayShift(PathReservoir source, ShadingData dstSd, HitInfo dstHit, uint2 dstPixel)
    {
        ShiftMappingResult result = {};
        result.originalTarget = source.target;
        result.jacobian = 1.f;

        const PathSample sample = source.sample;

        // Validity gates.
        if ((sample.flags & kPathSampleFlagValid) == 0u)
        {
            result.rejectionReason = 1u;
            return result;
        }
        if (source.target <= 0.f || sample.target <= 0.f)
        {
            result.rejectionReason = 2u;
            return result;
        }
        if ((sample.flags & kPathSampleFlagAlreadyShifted) != 0u)
        {
            // No canonical RNG stream to replay once a sample has been shifted into
            // another primary domain.
            result.rejectionReason = 15u;
            return result;
        }
        if (sample.selectedKind == kPathSampleKindEnv && sample.selectedVertex <= 1u)
        {
            // Camera-direct environment sample: no surface tail to replay at a
            // surface destination.
            result.rejectionReason = 8u;
            return result;
        }

        const uint2 sourcePixel = uint2(sample.pathID, sample.pathID >> 12) & 0xfff;

        // Build a replay path state positioned at the destination primary hit but
        // seeded with the source sample's exact random-number stream.
        PathState path = {};
        path.setActive();
        path.id = dstPixel.x | (dstPixel.y << 12) | (sample.pathID & 0xff000000u);
        path.pathSeed = sample.pathSeed;
        path.thp = float3(1.f);
        path.reconnectVertex = kInvalidReconnectVertex;

        Ray cameraRay = computeLightFieldRay(params, dstPixel);
        if (params.lfEnabled == 0u && kUseViewDir) cameraRay.dir = -viewDir[dstPixel];
        path.origin = cameraRay.origin;
        path.dir = cameraRay.dir;

        // Seed with the SOURCE pixel + seed so the random stream is identical to the
        // one that produced the source sample, regardless of SampleGenerator internals.
        path.sg = SampleGenerator(sourcePixel, sample.pathSeed);
        path.risState = hashPathState(sample.pathSeed ^ 0xa511e9b3u);
        path.selectedKind = kPathSampleKindInvalid;

        path.setHit(dstHit);
        path.setVertexIndex(1);

        // Drive the canonical path tracer on the destination geometry.
        RandomReplayVisibilityQuery vq;
        if (path.isHit()) handleHit(path, vq);
        else handleMiss(path);
        while (path.isActive())
        {
            randomReplayNextHit(path);
            if (path.isHit()) handleHit(path, vq);
            else handleMiss(path);
        }

        // Accept whenever the re-traced destination path produced contribution. path.L is the
        // full MIS-combined path contribution (accumulated, not a single RIS-selected technique),
        // so there is no per-technique mismatch to gate on.
        if (path.risTarget <= 0.f)
        {
            result.rejectionReason = 10u;
            return result;
        }

        const float3 shiftedContribution = path.L;
        const float shiftedTarget = path.risTarget;
        if (shiftedTarget <= 0.f || isnan(shiftedTarget) || isinf(shiftedTarget) || !any(shiftedContribution > 0.f))
        {
            result.rejectionReason = 10u;
            return result;
        }

        // Pure PSS replay: identity on random coordinates, unit Jacobian.
        PathSample shiftedSample = sample;
        shiftedSample.contribution = shiftedContribution;
        shiftedSample.target = shiftedTarget;
        shiftedSample.selectedVertex = path.selectedVertex;
        shiftedSample.selectedKind = path.selectedKind;
        shiftedSample.pathLength = getTerminatedPathLength(path);

        result.valid = true;
        result.shiftedContribution = shiftedContribution;
        result.shiftedSample = shiftedSample;
        result.shiftedTarget = shiftedTarget;
        result.targetRatio = source.target > 0.f ? shiftedTarget / source.target : 0.f;
        result.jacobian = 1.f;
        result.rejectionReason = 0u;
        return result;
    }
}
